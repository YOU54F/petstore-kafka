{
  "consumer": {
    "name": "adoptions-service"
  },
  "interactions": [
    {
      "comments": {
        "references": {
          "AsyncAPI": {
            "operationId": "publishPetStatusChanged"
          }
        }
      },
      "contents": {
        "content": {
          "id": "6c9f429c-3f5d-4a55-88bf-026b2b404710",
          "status": "available"
        },
        "contentType": "application/json",
        "encoded": false
      },
      "description": "a pet status change",
      "matchingRules": {
        "body": {
          "$.id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.status": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^(pending|available|onhold|adopted)$"
              }
            ]
          }
        }
      },
      "metadata": {
        "topic": "pets.statusChanged"
      },
      "pending": false,
      "providerStates": [
        {
          "name": "a pet exists"
        }
      ],
      "type": "Asynchronous/Messages"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "pets-service"
  }
}